{
  "name": "fitos",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/types"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @fitos/web",
    "build:web": "npm run build -w @fitos/web",
    "deploy": "npm run build:web && wrangler pages deploy apps/web/out --project-name fitos"
  },
  "devDependencies": {
    "supabase": "^3.2.0",
    "wrangler": "^4.166.0"
  }
}
